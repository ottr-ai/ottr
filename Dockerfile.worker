# syntax=docker/dockerfile:1
# D1 pins are deliberate; a bump is a new image build.
# oven/bun:1.4.4-debian pinned 2026-10-29 — must stay >= the bun the omp pin needs
# (omp 18.6.0's dist fails to parse on bun 1.3.3; the host runs 1.4.3).
# Digest-pinned 2026-10-22: a moved tag would silently change the worker image on the
# next build. To upgrade bun, read the new tag's digest with
# `docker buildx imagetools inspect oven/bun:<tag>` and move tag and digest together.
FROM oven/bun:1.4.4-debian@sha256:93d5032fe06d163427822dc1598f420363759bb18155c9cc90eb1be05a64a19e AS worker
# scripts/update-image.ts prunes superseded builds of this image by this label.
LABEL ottr.image=worker

# Debian trixie git version (the 1.4.4-debian base is trixie); a wrong pin fails the build loudly (D1).
ARG GIT_VERSION=1:2.47.3-0+deb13u1
# rtk (Rust Token Killer) — pix-optimizer rewrites known bash commands through it only
# when the binary is on PATH; without it every command runs raw. Host /usr/local/bin runs 1.0.1.
# amd64 uses static musl; arm64 uses glibc. A wrong pin fails the build loudly.
ARG RTK_VERSION=1.1.0
# Release checksums.txt, one archive per target architecture.
ARG RTK_SHA256_AMD64=9454ad1b9489daa57ab0a9f4ebe2faaf4dc82b8a0f26c9e5135151abd7c9378d
ARG RTK_SHA256_ARM64=a5c00c3ab0129884bcb757d348afc1a650efa0f4f0769da97c341f28f89719ed
# ripwire (redhat-et) — call-graph CLI for structure questions before shared-code edits
# (map, --impact, --affected). A wrong pin 404s the download (fails the build loudly).
ARG RIPWIRE_VERSION=0.6.8
# Release archive digests, one per target architecture.
ARG RIPWIRE_SHA256_AMD64=aa09e8c43acd2104db91a80f2824a36c314ea4a72fd565cd2e579e043e09b03b
ARG RIPWIRE_SHA256_ARM64=9015c41ac80af640cda54d98f69b68973e18f5b1c7c3c1116d80f81989513276
# gitleaks secret scanner: review gates that name it (e.g. ottr-cloud's AGENTS.md) run
# `gitleaks git .` on workers. Keep the version and amd64 checksum equal to the CI pin in
# .github/workflows/ci.yml ("Install gitleaks 8.30.1"). A bump changes both places.
# A wrong pin 404s the download or fails the checksum (fails the build loudly).
ARG GITLEAKS_VERSION=8.30.1
# Release checksums.txt, one archive per target architecture.
ARG GITLEAKS_SHA256_AMD64=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
ARG GITLEAKS_SHA256_ARM64=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
# GitHub CLI: the board publishes releases and creates repos with it, server-side, with its
# GitHub token (D6). Host runs 2.103.3. A wrong pin 404s the download (fails the build loudly).
ARG GH_VERSION=2.103.3
# Release checksums.txt, one archive per target architecture.
ARG GH_SHA256_AMD64=4c806978ffce1cec70853302a56d70ac6da4f19bae7adca4e1a8ab00633dd91d
ARG GH_SHA256_ARM64=ee32df2323c8847f5fac6cb6b4b69ca75828e9329a8f22f677021f7b3306ce63
# Node.js: npx starts the agent layer's MCP servers (chrome-devtools), and projects run
# their Node tooling with it (some need >= 24.21.0). Without it, `node` is bun's fallback and
# npx is missing. A wrong pin 404s the download (fails the build loudly).
ARG NODE_VERSION=24.21.0
# Release SHASUMS256.txt, one .tar.gz per target architecture.
ARG NODE_SHA256_AMD64=6e1db87ef58b8819e5d5402eff1536491b18edd8eb7bee5ef7897876e88dc5ff
ARG NODE_SHA256_ARM64=724282c3b43aec998aa9527380465b45d229e021b58035f5f4f63095eabfe5d5
# Debian trixie jq version; a wrong pin fails the build loudly (D1).
ARG JQ_VERSION=1.7.1-6+deb13u4
# Debian trixie procps version: killTree and the orphan report (src/platform/unix.ts) walk the
# process tree with `ps`. Without it a cancel kills only omp's own pid, and its children live on
# in the long-running server and worker containers. A wrong pin fails the build loudly (D1).
ARG PROCPS_VERSION=2:4.0.4-9
# Debian trixie curl version: the impeccable skill's launcher downloads the engine that a skill
# update needs with curl or wget. Without either, `impeccable detect` exits 127 in a container,
# and UI turns skip their accessibility scan. A wrong pin fails the build loudly (D1).
ARG CURL_VERSION=8.14.1-2+deb13u7
# Chrome for Testing for the agent layer's chrome-devtools MCP server, which starts the stable
# channel from /opt/google/chrome/chrome. Its shared libraries come from the projects' package
# lists (see below). A wrong pin 404s the download (fails the build loudly).
ARG CHROME_VERSION=154.0.8037.92
# Computed archive digests: Chrome for Testing publishes no checksums.
ARG CHROME_SHA256_AMD64=ff43322f335e436b2f4dcdfeeec5db032299e335a7e8c1c618b326e100ce8732
ARG CHROME_SHA256_ARM64=c0af361aab66b24c72e36a4326dce4d7edf4bc23f9aede8af988c2cb6ea3fec0
# Debian trixie git-lfs version. Projects can keep binary assets in LFS, and the
# server checks worktrees out through its filters before any package list installs, so it
# is in the image. A wrong pin fails the build loudly (D1).
ARG GIT_LFS_VERSION=3.6.1-1+deb13u1
# Debian trixie openssh-client version: clone, fetch and push over SSH for git hosts other
# than GitHub. Keys stay on the server; workers get only the binary (D6). A wrong pin fails
# the build loudly (D1).
ARG OPENSSH_CLIENT_VERSION=1:10.0p1-7+deb13u4
ARG AGENT_BROWSER_VERSION=0.41.1

# Debian trixie openssl version: the buildkit-certs one-off (compose `build` profile,
# docs/specs/turn-image-builds.md) generates the BuildKit TLS material with it.
# ca-certificates pulls openssl in as a dependency; the pin makes that load-bearing
# dependency loud. A wrong pin fails the build loudly (D1).
ARG OPENSSL_VERSION=3.5.7-1~deb13u3

# Keep bun's global bin outside /root — the HOME volume would shadow it.
ENV BUN_INSTALL=/usr/local/bun
ENV PATH="/usr/local/bun/bin:${PATH}"
ENV AGENT_BROWSER_EXECUTABLE_PATH=/opt/google/chrome/chrome

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      "git=${GIT_VERSION}" \
      "git-lfs=${GIT_LFS_VERSION}" \
      "jq=${JQ_VERSION}" \
      "procps=${PROCPS_VERSION}" \
      "curl=${CURL_VERSION}" \
      "openssh-client=${OPENSSH_CLIENT_VERSION}" \
      "openssl=${OPENSSL_VERSION}" \
      ca-certificates \
      python3 python3-venv make g++ pkg-config unzip \
    && rm -rf /var/lib/apt/lists \
    && git --version \
    && git lfs install --system --skip-repo \
    && git lfs version \
    && jq --version \
    && ps --version \
    && curl --version \
    && openssl version \
    && ssh -V

# ponytail: dpkg describes the target image, so Docker and Podman need no
# TARGETARCH build arg. Native is the default; --platform still selects a target.
# rtk on PATH (pinned, checksum-verified) so pix-optimizer's bash rewrite is active.
RUN case "$(dpkg --print-architecture)" in \
      amd64) RTK_TARGET=x86_64-unknown-linux-musl; RTK_SHA256="${RTK_SHA256_AMD64}" ;; \
      arm64) RTK_TARGET=aarch64-unknown-linux-gnu; RTK_SHA256="${RTK_SHA256_ARM64}" ;; \
      *) echo "Unsupported worker architecture" >&2; exit 1 ;; \
    esac \
    && bun -e "await Bun.write('/tmp/rtk.tar.gz', await (await fetch('https://github.com/rtk-ai/rtk/releases/download/v${RTK_VERSION}/rtk-${RTK_TARGET}.tar.gz')).bytes())" \
    && echo "${RTK_SHA256}  /tmp/rtk.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/rtk.tar.gz -C /tmp \
    && install -m 0755 /tmp/rtk /usr/local/bin/rtk \
    && rm -f /tmp/rtk.tar.gz /tmp/rtk \
    && rtk --version

# ripwire on PATH (pinned, checksum-verified) so turn agents map before they read.
RUN case "$(dpkg --print-architecture)" in \
      amd64) RIPWIRE_ARCH=x64; RIPWIRE_SHA256="${RIPWIRE_SHA256_AMD64}" ;; \
      arm64) RIPWIRE_ARCH=arm64; RIPWIRE_SHA256="${RIPWIRE_SHA256_ARM64}" ;; \
      *) echo "Unsupported worker architecture" >&2; exit 1 ;; \
    esac \
    && bun -e "await Bun.write('/tmp/ripwire.tar.gz', await (await fetch('https://github.com/redhat-et/ripwire/releases/download/v${RIPWIRE_VERSION}/ripwire-${RIPWIRE_VERSION}-linux-${RIPWIRE_ARCH}.tar.gz')).bytes())" \
    && echo "${RIPWIRE_SHA256}  /tmp/ripwire.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/ripwire.tar.gz -C /tmp \
    && install -m 0755 "/tmp/ripwire-${RIPWIRE_VERSION}-linux-${RIPWIRE_ARCH}/ripwire" /usr/local/bin/ripwire \
    && rm -rf "/tmp/ripwire-${RIPWIRE_VERSION}-linux-${RIPWIRE_ARCH}" /tmp/ripwire.tar.gz \
    && ripwire --version

# gitleaks on PATH (pinned, checksum-verified) so review gates that name it run on workers.
RUN case "$(dpkg --print-architecture)" in \
      amd64) GITLEAKS_ARCH=x64; GITLEAKS_SHA256="${GITLEAKS_SHA256_AMD64}" ;; \
      arm64) GITLEAKS_ARCH=arm64; GITLEAKS_SHA256="${GITLEAKS_SHA256_ARM64}" ;; \
      *) echo "Unsupported worker architecture" >&2; exit 1 ;; \
    esac \
    && bun -e "await Bun.write('/tmp/gitleaks.tar.gz', await (await fetch('https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GITLEAKS_ARCH}.tar.gz')).bytes())" \
    && echo "${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/gitleaks.tar.gz -C /tmp \
    && install -m 0755 /tmp/gitleaks /usr/local/bin/gitleaks \
    && rm -f /tmp/gitleaks.tar.gz /tmp/gitleaks \
    && gitleaks version

# gh on PATH (pinned, checksum-verified). Workers get no GitHub token (D6), so there it reads
# public data only.
RUN GH_ARCH="$(dpkg --print-architecture)" \
    && case "$GH_ARCH" in \
      amd64) GH_SHA256="${GH_SHA256_AMD64}" ;; \
      arm64) GH_SHA256="${GH_SHA256_ARM64}" ;; \
      *) echo "Unsupported worker architecture" >&2; exit 1 ;; \
    esac \
    && bun -e "await Bun.write('/tmp/gh.tar.gz', await (await fetch('https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${GH_ARCH}.tar.gz')).bytes())" \
    && echo "${GH_SHA256}  /tmp/gh.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/gh.tar.gz -C /tmp "gh_${GH_VERSION}_linux_${GH_ARCH}/bin/gh" \
    && install -m 0755 "/tmp/gh_${GH_VERSION}_linux_${GH_ARCH}/bin/gh" /usr/local/bin/gh \
    && rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_${GH_ARCH}" \
    && gh --version

# buildctl on PATH (pinned, checksum-verified): the client for the rootless BuildKit
# sidecar (compose `build` profile, docs/specs/turn-image-builds.md). The daemon runs
# in the compose stack; the image carries only the client. The release names the asset
# with dots (buildkit-v<version>.linux-<arch>.tar.gz) and publishes no checksums file.
# Each archive is pinned by its release asset's SHA-256 digest.
ARG BUILDKIT_VERSION=0.34.2
ARG BUILDKIT_SHA256_AMD64=b9f18b8e37eb450e9e5df03117045237cdd12d3c4a0034ffeeaa857852a15e13
ARG BUILDKIT_SHA256_ARM64=a4ad483a33b2f1544c5ccce1c5956c559e1a6e84b8bf6cedd847d695885237a3
RUN BUILDKIT_ARCH="$(dpkg --print-architecture)" \
    && case "$BUILDKIT_ARCH" in \
      amd64) BUILDKIT_SHA256="${BUILDKIT_SHA256_AMD64}" ;; \
      arm64) BUILDKIT_SHA256="${BUILDKIT_SHA256_ARM64}" ;; \
      *) echo "Unsupported worker architecture" >&2; exit 1 ;; \
    esac \
    && bun -e "await Bun.write('/tmp/buildkit.tar.gz', await (await fetch('https://github.com/moby/buildkit/releases/download/v${BUILDKIT_VERSION}/buildkit-v${BUILDKIT_VERSION}.linux-${BUILDKIT_ARCH}.tar.gz')).bytes())" \
    && echo "${BUILDKIT_SHA256}  /tmp/buildkit.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/buildkit.tar.gz -C /tmp bin/buildctl \
    && install -m 0755 /tmp/bin/buildctl /usr/local/bin/buildctl \
    && rm -rf /tmp/buildkit.tar.gz /tmp/bin \
    && buildctl --version

# node, npm and npx on PATH (pinned, checksum-verified); they shadow bun's node fallback.
RUN case "$(dpkg --print-architecture)" in \
      amd64) NODE_ARCH=x64; NODE_SHA256="${NODE_SHA256_AMD64}" ;; \
      arm64) NODE_ARCH=arm64; NODE_SHA256="${NODE_SHA256_ARM64}" ;; \
      *) echo "Unsupported worker architecture" >&2; exit 1 ;; \
    esac \
    && bun -e "await Bun.write('/tmp/node.tar.gz', await (await fetch('https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.gz')).bytes())" \
    && echo "${NODE_SHA256}  /tmp/node.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/node.tar.gz -C /usr/local --strip-components=1 \
      --exclude="node-v${NODE_VERSION}-linux-${NODE_ARCH}/*.md" --exclude="node-v${NODE_VERSION}-linux-${NODE_ARCH}/LICENSE" \
    && rm -f /tmp/node.tar.gz \
    && node --version \
    && npx --version

# Chrome on the path chrome-devtools-mcp looks for (pinned, checksum-verified).
RUN case "$(dpkg --print-architecture)" in \
      amd64) CHROME_PLATFORM=linux64; CHROME_SHA256="${CHROME_SHA256_AMD64}" ;; \
      arm64) CHROME_PLATFORM=linux-arm64; CHROME_SHA256="${CHROME_SHA256_ARM64}" ;; \
      *) echo "Unsupported worker architecture" >&2; exit 1 ;; \
    esac \
    && bun -e "await Bun.write('/tmp/chrome.zip', await (await fetch('https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION}/${CHROME_PLATFORM}/chrome-${CHROME_PLATFORM}.zip')).bytes())" \
    && echo "${CHROME_SHA256}  /tmp/chrome.zip" | sha256sum -c - \
    && unzip -q /tmp/chrome.zip -d /opt \
    && rm -f /tmp/chrome.zip \
    && mkdir -p /opt/google/chrome \
    && ln -s "/opt/chrome-${CHROME_PLATFORM}/chrome" /opt/google/chrome/chrome

# Regression check: emulation must not hide a wrong-architecture tool archive.
# Chrome's libraries are project packages, so inspect ELF without launching Chrome.
# Use ordinary RUN syntax so Podman/Buildah needs no Dockerfile heredoc support.
RUN python3 -c "$(printf '%s\n' \
    'import struct' \
    'import subprocess' \
    '' \
    'arch = subprocess.check_output(["dpkg", "--print-architecture"], text=True).strip()' \
    'expected = {"amd64": 62, "arm64": 183}[arch]' \
    'for path in ("/usr/local/bin/rtk", "/usr/local/bin/ripwire", "/usr/local/bin/gitleaks",' \
    '             "/usr/local/bin/gh", "/usr/local/bin/buildctl", "/usr/local/bin/node",' \
    '             "/opt/google/chrome/chrome"):' \
    '    with open(path, "rb") as binary:' \
    '        header = binary.read(20)' \
    '    assert header[:4] == b"\x7fELF" and header[5] == 1, f"{path}: not little-endian ELF"' \
    '    assert struct.unpack_from("<H", header, 18)[0] == expected, f"{path}: not {arch}"' \
    'print(f"Worker tools verified: {arch}")')"

# The pinned agent-browser doctor finds Chrome by its standard PATH name.
RUN bun install -g --ignore-scripts --minimum-release-age 604800 "agent-browser@${AGENT_BROWSER_VERSION}" \
    && ln -s /opt/google/chrome/chrome /usr/local/bin/google-chrome \
    && agent-browser --version

# Language servers for omp's lsp tool. omp starts a built-in server when the repo root holds one
# of its root markers and the binary is in the project's node_modules/.bin or on PATH; a new
# worktree has no node_modules when omp starts, so without these a turn gets no language server.
# TypeScript 7's tsc serves TS/JS (`tsc --lsp`), typescript-language-server serves projects whose
# own TypeScript is older, pyright serves Python. A wrong pin fails the build loudly.
ARG TYPESCRIPT_VERSION=7.0.2
ARG TS_LANGUAGE_SERVER_VERSION=6.0.2
ARG PYRIGHT_VERSION=1.1.414
RUN bun install -g "typescript@${TYPESCRIPT_VERSION}" \
      "typescript-language-server@${TS_LANGUAGE_SERVER_VERSION}" \
      "pyright@${PYRIGHT_VERSION}" \
    && tsc --version \
    && typescript-language-server --version \
    && pyright --version

# omp is the main tool and follows its npm releases: .github/workflows/omp-bump.yml moves this
# pin (docs/WORKERS.md, "Updates"). It is declared here, not with the other pins: a changed ARG
# invalidates every later RUN, so a bump rebuilds only the layers below.
ARG OMP_VERSION=18.15.0
# toon CLI (npm @toon-format/cli) for the bundled toon-json skill — must match
# the host's toon so workers and host produce identical output.
ARG TOON_VERSION=4.4.0
RUN bun install -g "@oh-my-pi/pi-coding-agent@${OMP_VERSION}" \
    && bun install -g "@toon-format/cli@${TOON_VERSION}" \
    && omp --version \
    && toon --version

# No project's system packages are baked in (e.g. the libraries Chrome needs): each project
# lists them in the data repo, and a worker installs every list when it starts (src/apt.ts).
# git-lfs above is the one exception. A tool with no Debian package (e.g. Godot) goes into a
# project's tools.json instead, which a container installs at runtime (docs/WORKERS.md).

# Runtime GitHub auth: the board keeps the token from onboarding/Settings and exports it as
# GH_TOKEN to server-side git, gh and merge turns only (D6); the worker daemon strips it
# from every work turn's env. This helper hands it to git for github.com remotes, and names
# the cause instead of git's bare prompt failure without it.
RUN git config --system credential.https://github.com.helper \
      '!f() { test "$1" = get || exit 0; if [ -z "$GH_TOKEN" ]; then echo "ottr: no GH_TOKEN here; the board passes its GitHub token (Settings) to server-side git only" >&2; exit 0; fi; echo username=x-access-token; echo "password=$GH_TOKEN"; }; f'

WORKDIR /app
COPY package.json bun.lock tsconfig.json ./
COPY src ./src
COPY extension ./extension
RUN bun install --frozen-lockfile --production
# The image ships no .git, so the board takes its version from this stamp instead of git
# describe (src/worktree.ts describeVersion). release.yml passes the release tag; a local
# build leaves it empty and a git checkout describes itself at runtime.
ARG OTTR_VERSION=
ENV OTTR_VERSION=${OTTR_VERSION}
# Every Node process preloads the Stryker tap (src/stryker-tap.cjs): a `stryker run` copies
# its stdout to /tmp/ottr-stryker-<pid>.log, so the running card shows the progress even when
# the agent's command pipes the output (rtk). Every other process returns at once; bun
# ignores NODE_OPTIONS. A project script that sets its own NODE_OPTIONS drops the tap.
ENV NODE_OPTIONS=--require=/app/src/stryker-tap.cjs

COPY docker/ottr-entry.sh /ottr-entry.sh
COPY docker/no-proxy.sh /no-proxy.sh
RUN chmod +x /ottr-entry.sh

EXPOSE 4747 8787
ENTRYPOINT ["/ottr-entry.sh"]

# The microVM runner (compose service vm-runner, profile vm; OTTR-532): runs each work turn
# of an opted-in project in its own Firecracker microVM. Built only with `--target
# vm-runner`; the guest's base rootfs is built from this container's own root, so the
# guest gets the worker's tools, omp and /app unchanged. It inherits LABEL ottr.image=worker
# on purpose: scripts/update-image.ts prunes its superseded builds with the worker's.
FROM worker AS vm-runner
# The pinned guest kernel and boot arguments are x86_64-only; worker builds skip this stage.
RUN test "$(dpkg --print-architecture)" = amd64 \
    || { echo "vm-runner supports amd64 only; build the worker target on arm64" >&2; exit 1; }
# Firecracker (VMM) static musl binary from the official release. Host-independent: it
# needs only /dev/kvm. A wrong pin 404s the download (fails the build loudly).
ARG FIRECRACKER_VERSION=1.17.0
# sha256 of firecracker-v${FIRECRACKER_VERSION}-x86_64.tgz from the release's
# firecracker-v${FIRECRACKER_VERSION}-x86_64.tgz.sha256.txt (equal to the asset's GitHub digest).
ARG FIRECRACKER_SHA256=06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558
# Guest kernel: the Firecracker CI's uncompressed x86_64 vmlinux 6.1 from the firecracker-ci
# bucket that the release's docs/getting-started.md downloads from (the dated prefix is the
# CI artifact build of firecracker commit 6ea6634994fa, 2026-11-05). Checked when pinned,
# in the artifact's own vmlinux-6.1.188.config and in the source config
# resources/guest_configs/microvm-kernel-ci-x86_64-6.1.config at that commit: OVERLAY_FS,
# EXT4_FS, VIRTIO_BLK, VIRTIO_NET, VIRTIO_MMIO + ACPI (device discovery), IP_PNP (the
# cmdline's ip=), DEVTMPFS + DEVTMPFS_MOUNT, MAGIC_SYSRQ (power off), SERIO_I8042 (reboot=k
# ends the VMM), SERIAL_8250_CONSOLE (ttyS0), all =y; MODULES is off, so nothing loads later.
# A wrong URL 404s the download (fails the build loudly).
ARG VM_KERNEL_URL=https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/20261105-6ea6634994fa-0/x86_64/vmlinux-6.1.188
# sha256 of vmlinux-6.1.188, computed when pinned: the bucket publishes no checksums.
ARG VM_KERNEL_SHA256=31fe88d6c72b93d5c9c63cca599ccadec49fd35673bbfd04850d6c00ff27f032
# Debian trixie versions; a wrong pin fails the build loudly (D1). iptables: the per-VM
# egress rules and NAT; iproute2: the per-VM tap devices; e2fsprogs: mkfs.ext4 -d builds
# the rootfs, layer and scratch disks without a loop mount.
ARG IPTABLES_VERSION=1.8.11-2
ARG IPROUTE2_VERSION=6.15.0-1
ARG E2FSPROGS_VERSION=1.47.2-3+b12

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      "iptables=${IPTABLES_VERSION}" \
      "iproute2=${IPROUTE2_VERSION}" \
      "e2fsprogs=${E2FSPROGS_VERSION}" \
    && rm -rf /var/lib/apt/lists \
    && iptables --version \
    && ip -V \
    && mkfs.ext4 -V

# firecracker on PATH (pinned, checksum-verified).
RUN bun -e "await Bun.write('/tmp/firecracker.tgz', await (await fetch('https://github.com/firecracker-microvm/firecracker/releases/download/v${FIRECRACKER_VERSION}/firecracker-v${FIRECRACKER_VERSION}-x86_64.tgz')).bytes())" \
    && echo "${FIRECRACKER_SHA256}  /tmp/firecracker.tgz" | sha256sum -c - \
    && tar -xzf /tmp/firecracker.tgz -C /tmp "release-v${FIRECRACKER_VERSION}-x86_64/firecracker-v${FIRECRACKER_VERSION}-x86_64" \
    && install -m 0755 "/tmp/release-v${FIRECRACKER_VERSION}-x86_64/firecracker-v${FIRECRACKER_VERSION}-x86_64" /usr/local/bin/firecracker \
    && rm -rf /tmp/firecracker.tgz "/tmp/release-v${FIRECRACKER_VERSION}-x86_64" \
    && firecracker --version

# The guest kernel where vm-runner looks for it (OTTR_VM_KERNEL; pinned, checksum-verified).
RUN mkdir -p /opt/ottr-vm \
    && bun -e "await Bun.write('/opt/ottr-vm/vmlinux', await (await fetch('${VM_KERNEL_URL}')).bytes())" \
    && echo "${VM_KERNEL_SHA256}  /opt/ottr-vm/vmlinux" | sha256sum -c -

# The guest's PID 1 (kernel cmdline init=): mounts the drives, builds the overlay root and
# runs the guest agent (src/vmGuest.ts). It ships in the rootfs because the rootfs is this root.
COPY docker/ottr-vm-init /usr/local/bin/ottr-vm-init
RUN chmod 0755 /usr/local/bin/ottr-vm-init

# No /ottr-entry.sh here: its credential checks refuse a container without agent.db and the
# oauth dir, and vm-runner mounts neither by design (no provider secret reaches a VM). The
# Podman proxy fix still applies: the runner's own calls must not go to a host proxy.
ENTRYPOINT ["/bin/sh", "-c", ". /no-proxy.sh && exec \"$@\"", "ottr-vm-runner"]
CMD ["bun", "/app/src/vmRunnerMain.ts"]

# The default (untargeted) build stays the classic worker image the server and the workers
# run: the last stage is the build's result, and BuildKit skips vm-runner unless targeted.
FROM worker
