{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"files": {
		"maxSize": 2097152,
		"includes": [
			"src/**",
			"scripts/**",
			"extension/**",
			".agents/skills/check-ottr-board/scripts/**",
			"!!**/.worktrees",
			"!!**/.dev",
			"!!src/fixtures"
		]
	},
	"linter": {
		"rules": {
			"complexity": {
				"noExcessiveCognitiveComplexity": "info"
			},
			"suspicious": {
				"noImportCycles": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noUnusedFunctionParameters": "error",
				"useHookAtTopLevel": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.js"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["scripts/gate-harness/**"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					},
					"suspicious": {
						"noTemplateCurlyInString": "off"
					}
				}
			}
		}
	]
}
