{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/worker.ts",
    "src/ui/app.tsx",
    "src/stryker-tap.cjs",
    "scripts/**/*.{js,mjs,ts}",
    "extension/tracker.ts"
  ],
  "ignoreBinaries": ["tailscale", "ssh-keygen", "mkfifo"],
  "ignoreDependencies": [
    "@stryker-mutator/api",
    "@stryker-mutator/command-runner",
    "@stryker-mutator/instrumenter",
    "@hughescr/stryker-bun-runner"
  ],
  "ignoreUnresolved": ["src/server.ts"]
}
